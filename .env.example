# Flutter public configuration: pass with --dart-define-from-file to a local,
# ignored JSON file. Default requires no configuration and enables offline playtest.
MILO_SERVICES=playtest
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MILO_MONTHLY_PRODUCT=
MILO_ANNUAL_PRODUCT=
# Server ONLY. Set in Supabase secrets, never Flutter or Git.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
PURCHASE_ENCRYPTION_KEY=
ANDROID_PACKAGE=com.framebynavin.milo
# Production signing: ignored android/key.properties and external keystore.
